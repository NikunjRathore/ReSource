// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  DONOR_INDIVIDUAL
  NGO_RECIPIENT
  ADMIN
}

enum ItemCategory {
  FOOD
  TOY
  CLOTH
  BOOK
  FURNITURE
}

enum ListingStatus {
  AVAILABLE
  CLAIMED
  IN_TRANSIT
  COMPLETED
  EXPIRED
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         Role
  items     Item[]      @relation("DonorListings")
  claims       Claim[]        @relation("NgoClaims")
  sessions     Session[]
  createdAt    DateTime       @default(now())
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])//for fastening of a particular user's sessions
  @@index([expiresAt])// for fastly finding the the session need to be deleted
}


model Tag {
  id    String    @id @default(uuid())
  name  String    @unique
  items ItemTag[]
}

model ItemTag {
  itemId String
  tagId  String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

model Item {
  id           String        @id @default(uuid())
  title        String
  description  String?
  imageUrl     String?
  category     ItemCategory
  quantity     Int
  unit         String
  expiryDate   DateTime?
  status       ListingStatus @default(AVAILABLE)

  donorId      String
  donor        User          @relation("DonorListings", fields: [donorId], references: [id])

  tags         ItemTag[]
  claim        Claim?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Claim {
  id           String        @id @default(uuid())
  itemId    String        @unique
  item      Item       @relation(fields: [itemId], references: [id])

  ngoId        String
  ngo          User          @relation("NgoClaims", fields: [ngoId], references: [id])

  claimedAt    DateTime      @default(now())
  completedAt  DateTime?
  handoffCode  String        // 4-digit secure code verified during physical pickup
}